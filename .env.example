# Hiring Reels — local Instagram hiring-reels scraper.
# Copy to .env and fill in. Real values here (the session cookie, the Supabase
# service key) must NEVER be committed — this repo's .gitignore excludes
# .env, out/ and .venv/.

# Session cookie from a THROWAWAY Instagram account — never your main one.
# Extract it from a logged-in browser session:
#   DevTools → Application (Storage) → Cookies → https://www.instagram.com
#   → copy the `sessionid` value (the long quoted string).
# It expires when the account logs out or changes password — re-extract then.
IG_SESSIONID=

# Supabase project that approved rows are pushed to. The service-role key
# bypasses RLS and stays local — nothing server-side ever needs it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional knobs (defaults shown)
# REELS_MAX_POSTS=12
# REELS_BATCH_SIZE=10
# REELS_TAG_TIMEOUT=180
# REELS_TABS=clips            # hashtag tabs to fetch: clips (reels), recent (grid)
